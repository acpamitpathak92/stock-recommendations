{
  "name": "stock-ai-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mcp:market": "tsx src/mcp/market-server.ts",
    "mcp:technical": "tsx src/mcp/technical-server.ts",
    "mcp:financial": "tsx src/mcp/financial-server.ts",
    "mcp:news": "tsx src/mcp/news-server.ts",
    "mcp:sentiment": "tsx src/mcp/sentiment-server.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@google/genai": "^2.8.0",
    "@langchain/langgraph": "^1.4.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.18.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "yahoo-finance2": "^2.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
